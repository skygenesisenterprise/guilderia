{
  "name": "@guilderia/toolkit-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Utility bot for the guilderia.js discord server",
  "keywords": [
    "guilderia",
    "guilderia-app",
    "slashcommand",
    "utilities"
  ],
  "license": "Apache-2.0",
  "author": "Sky Genesis Enterprise <github@skygenesisenterprise.com>",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:clean": "del-cli dist",
    "build:check": "tsc --noEmit",
    "build:esm": "swc ./src --out-dir ./dist",
    "build": "yarn build:clean && yarn build:check && yarn build:esm",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "ofxfmt --check",
    "start": "env-cmd node --enable-source-maps dist/index.js",
    "start:dev": "npm run build && npm run dev",
    "dev": "env-cmd node --enable-source-maps dist/index.js",
    "deploy:commands": "env-cmd node --enable-source-maps dist/deploy.js",
    "postinstall": "is-ci || husky install"
  },
  "dependencies": {
    "@discordjs/core": "^2.2.0",
    "@discordjs/formatters": "^0.6.1",
    "@discordjs/rest": "^2.5.1",
    "@discordjs/ws": "^2.0.3",
    "@ltd/j-toml": "^1.38.0",
    "@swc/helpers": "^0.5.1",
    "discord-api-types": "^0.38.15",
    "env-cmd": "^10.1.0",
    "kleur": "^4.1.5",
    "pino": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "tsyringe": "^4.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.5",
    "@commitlint/config-angular": "^17.6.5",
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.3.5",
    "@types/node": "^18.8.3",
    "@types/prettier": "^2.7.2",
    "del-cli": "^5.0.0",
    "husky": "^8.0.1",
    "is-ci": "^3.0.1",
    "lint-staged": "^13.2.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.76.0",
    "rimraf": "^3.0.2",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.7.0"
  },
  "packageManager": "yarn@3.5.1"
}
